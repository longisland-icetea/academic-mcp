# academic-mcp configuration — copy to `.env` beside this file and fill in.
# Precedence at startup: process environment > this file > ~/.shellrc.

# ── server ────────────────────────────────────────────────────────────────
ACADEMIC_MCP_HOST=127.0.0.1
ACADEMIC_MCP_PORT=8790
# ACADEMIC_MCP_LOG_LEVEL=INFO
# ACADEMIC_MCP_LOG_FILE=

# ── storage ───────────────────────────────────────────────────────────────
# Library root: project memory JSON, pdfs/, texts/, search_cache/, telemetry/
# Use an ABSOLUTE path. This service expands a leading `~` (config.py), but a
# JSON-RPC client that reads this file to learn where the library is may not —
# the DSH side joined the literal `~/data/academic` onto the session cwd, which
# put telemetry in a `./~/data/academic/` directory and made the working-memory
# pointer point nowhere. That reader now expands `~` too; absolute is still the
# value that cannot be misread.
ACADEMIC_DATA_DIR=/home/CHANGE_ME/data/academic
# Local document-conversion cache
# ACADEMIC_DOC_CACHE=~/.cache/academic-mcp/doc-read
# Roots a `convert_document` LOCAL path may live under, colon-separated. Local
# documents are UPLOADED to MinerU, so this is the boundary that decides what a
# caller can send off the machine; dot-directories are refused even inside a
# root. Add a directory when a caller must convert documents that live outside
# the library (e.g. a file the user just uploaded).
ACADEMIC_DOC_ROOTS=~/data/academic
# Hard ceiling for ONE conversion (upload + poll + download), in seconds. The
# per-poll timeout above can be larger; this is the bound that stops the retries
# multiplying into an hour-long tool call holding the per-document lock.
# ACADEMIC_CONVERT_BUDGET=900

# ── API keys (leave a line empty to disable that backend) ─────────────────
# MinerU cloud PDF→Markdown (required for conversion)
MINERU_TOKEN=
# MINERU_TOKEN is not a permanent API key: it is the OpenXLab SSO token
# (`uaa-token`) mineru.net issues on login, and it is a JWT with a short lifetime
# (14 days measured 2026-10-19; the one before that lasted 90). When it lapses
# every conversion fails with HTTP 401 (msgCode A0202)
# while downloads keep working — the symptom is "only the conversion is broken".
#
# Fill in the account you log in with at https://mineru.net/apiManage (email,
# phone number or username) and its password, and the service renews the token
# itself: on startup when it is expired or within MINERU_TOKEN_RENEW_DAYS, and
# immediately when a conversion is rejected with 401.
#
#   MINERU_ACCOUNT=you@example.com
#   MINERU_PASSWORD=…
#
# Leave MINERU_PASSWORD empty to disable automatic renewal (MINERU_TOKEN is then
# used as-is and only the expiry warning remains). Two consequences to weigh
# before filling this in:
#   * the password sits in clear text here, so keep the file mode 0600 and owned
#     by the service user (this example file must stay empty);
#   * renewal drives the real mineru.net login page in a browser (Camoufox),
#     because the SSO requires an Aliyun captcha that plain HTTP cannot pass.
#     Measured 2026-10-19: the page redirects to the SSO form, the form is filled,
#     登录 is clicked, and the "确认您不是机器人" checkbox is clicked automatically.
#     If the captcha ever escalates to a slider, renew with `--visible` and drag
#     it yourself (see README).
#
# A renewed token is written to MINERU_TOKEN_FILE (default
# ~/.local/state/academic-mcp/mineru_token.json, mode 0600) — NOT back into this
# file, which the systemd unit mounts read-only. Whichever of that file and this
# MINERU_TOKEN expires later is the one used, so pasting a fresh token here by
# hand still takes effect immediately.
# MINERU_ACCOUNT=
# MINERU_PASSWORD=
# Scopus / ScienceDirect
ELSEVIER_API_KEY=
# NOTE: an institutional insttoken is NOT supported — the service used to
# advertise one and never sent the header. Institution-level access comes from
# ELSEVIER_API_KEY itself, or from routing through DOWNLOAD_PROXY.
# OpenAlex premium key (literature search + citation chains)
OPENALEX_API_KEY=
# DeepSeek Search API — the web engine behind the arXiv title rescue. Billed per
# successful request (5 CNY / 1000, no charge for an empty result), 5 QPS per
# account. Optional: without it `ARXIV_SEARCH_ENGINE=auto` keeps using DDGS.
# It is called directly; do NOT route it through GFW_PROXY.
DEEPSEEK_API_KEY=

# ── proxies ───────────────────────────────────────────────────────────────
# Publisher/API access, and the RESCUE route in failover mode, e.g.
# http://192.168.255.2:8889. Empty = direct connections only, nothing to hop to.
DOWNLOAD_PROXY=
# primary | fallback | failover | none.
#   failover / fallback — direct first, DOWNLOAD_PROXY on a transport failure;
#   primary            — always through DOWNLOAD_PROXY.
DOWNLOAD_PROXY_MODE=fallback
# OpenAlex search / arXiv access. Separate because that traffic is usually a
# different door than the publisher one.
GFW_PROXY=

# ── tuning (defaults shown; uncomment to override) ────────────────────────
# ACADEMIC_SEARCH_TIMEOUT=120
# ACADEMIC_HTTP_TIMEOUT=45
# ACADEMIC_HTTP_CONNECT_TIMEOUT=15
# ACADEMIC_HTTP_MAX_BYTES=209715200
# ACADEMIC_DOWNLOAD_BUDGET=420
# MINERU_API_BASE=https://mineru.net/api/v4
# MINERU_MODEL=vlm
# MINERU_LANGUAGE=en
# MINERU_TIMEOUT=900
# MINERU_POLL_INTERVAL=4.0
# MinerU token renewal (see "Token renewal" above):
# MINERU_TOKEN_RENEW=true
# MINERU_TOKEN_RENEW_DAYS=7
# MINERU_LOGIN_TIMEOUT=180
# MINERU_TOKEN_FILE=~/.local/state/academic-mcp/mineru_token.json
# MINERU_LOGIN_URL=https://mineru.net/apiManage/token
# CAMOUFOX_ENABLED=true
# CAMOUFOX_TIMEOUT=90
# CAMOUFOX_HEADLESS=auto
# CAMOUFOX_BUDGET=240
# ARXIV_SEARCH_ENABLED=true
# ARXIV_SEARCH_TIMEOUT=35.0
# Which web engine is consulted when the arXiv API's title query comes back
# empty. The API itself is always asked first — this only selects the rescue.
#   auto     — deepseek when DEEPSEEK_API_KEY is set, else ddgs (default)
#   deepseek — DeepSeek Search API
#   ddgs     — DuckDuckGo/Brave/Google fan-out (measured refusing us; opt-in)
#   none     — API only, never a search engine
# ARXIV_SEARCH_ENGINE=auto
# DEEPSEEK_SEARCH_BASE=https://api.deepseek.com
# (Removed) PI_DOC_READ_CACHE — no code has read this since the pi-era cache
# was adopted; the conversion cache is ACADEMIC_DOC_CACHE above.
