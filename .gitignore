# secrets and local state — never commit these
# `.env.*` covers editor and backup copies (.env.bak-<stamp>), which carry the
# same live keys as `.env`; the example is the one file that must stay tracked.
.env
.env.*
*.env
!.env.example

# virtualenv / caches / build output
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# runtime data (the service owns these, they do not belong in git)
data/
*.log

# editors / OS
.DS_Store
.idea/
.vscode/
